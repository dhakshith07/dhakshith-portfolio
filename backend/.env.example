# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/portfolio
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Admin Secret Key for Protected Project APIs (POST, PUT, DELETE)
ADMIN_KEY=dhakshith_admin_secret_2026
